{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rewards Engine configuration",
  "type": "object",
  "required": ["wallets", "adapters"],
  "properties": {
    "wallets": {
      "type": "array",
      "items": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"}
    },
    "adapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "chainId", "rpcUrl", "contract", "abi"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "chainId": {"type": "integer", "minimum": 1},
          "rpcUrl": {"type": "string", "format": "uri"},
          "contract": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "abi": {"type": "array"}
        }
      }
    }
  }
}
